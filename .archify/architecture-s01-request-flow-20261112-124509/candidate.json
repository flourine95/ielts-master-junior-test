  "cards": [
    {
      "dot": "rose",
      "title": "Vì sao B01 không lọt ra",
      "items": [
        "getSession() không đọc query, path, body, header hay cookie",
        "getAssignmentsForStudent() là chỗ lọc duy nhất, page và API dùng chung",
        "AssignmentView không có trường định danh; schema strictObject ném lỗi nếu lọt"
      ]
    },
    {
      "dot": "amber",
      "title": "Thời gian",
      "items": [
        "SIMULATED_NOW là hằng trong src/lib/now.ts, không phải new Date()",
        "getStatus() nhận now làm tham số nên test được với mốc cố định",
        "So sánh dùng > nên now đúng hạn chưa tính là quá hạn"
      ]
    },
    {
      "dot": "cyan",
      "title": "Đã lái thử rồi bỏ",
      "items": [
        "Cookie ielts_session=demo-s02: ai đọc source cũng chuyển được sang S02, nên bỏ",
        "node:sqlite: thêm tầng runtime mà không đổi logic trạng thái",
        "Prisma và React Query: một bảng, không client fetching, không đủ việc để làm"
      ]
    }
  ]
